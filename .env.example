# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing auth tokens (auto-generated fallback in dev).
# WAJIB diganti dengan string acak panjang saat go-live.
SESSION_SECRET="change-this-secret-in-production"

# DATABASE DRIVER: "json" (default preview) atau "mysql" (produksi, transaksi ACID).
DB_DRIVER="json"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="reffo_printflow"

# ENABLE_DEMO_SWITCH: "false" saat produksi agar login cepat divisi & ganti akun dinonaktifkan.
ENABLE_DEMO_SWITCH="false"

# MAX_UPLOAD_MB: Batas ukuran file unggahan (desain/bukti bayar), default 20 MB.
MAX_UPLOAD_MB="20"

# KOMISI_PERSEN: Persentase komisi admin dari omzet nota (laporan Owner), default 1.
KOMISI_PERSEN="1"

# WHATSAPP_WEBHOOK_URL: Endpoint gateway WhatsApp (opsional).
# Jika kosong, kelima event (nota_dibuat, preview_siap_acc, siap_diambil,
# piutang_jatuh_tempo, pajak_reklame_jatuh_tempo) tetap masuk ke outbox dengan status pending.
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""

# PAJAK_REKLAME_HARI: Jendela pengingat pajak reklame tahunan dalam hari (default 30).
PAJAK_REKLAME_HARI="30"

# AUTO_CLEAN_TIFF_HARI: Retensi file cetak TIFF dalam hari (default 90).
# Hanya TIFF terverifikasi pada nota selesai yang dihapus; preview/master dipertahankan.
AUTO_CLEAN_TIFF_HARI="90"

# PORT: Port server Express (default 3000).
PORT="3000"
