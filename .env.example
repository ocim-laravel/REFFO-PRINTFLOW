# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing auth tokens.
# WAJIB diisi minimal 32 karakter acak saat NODE_ENV=production; server menolak start bila kosong/pendek.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-this-secret-in-production"

# DATABASE DRIVER: "json" (default preview) atau "mysql" (produksi, transaksi ACID).
DB_DRIVER="json"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="reffo_printflow"

# ENABLE_DEMO_SWITCH: "false" saat produksi agar login cepat divisi & ganti akun dinonaktifkan.
# Produksi menolak start bila nilai ini bukan "false".
ENABLE_DEMO_SWITCH="false"

# MAX_UPLOAD_MB: Batas ukuran file unggahan (desain/bukti bayar), default 20 MB.
MAX_UPLOAD_MB="20"

# KOMISI_PERSEN: Persentase komisi admin dari omzet nota (laporan Owner), default 1.
KOMISI_PERSEN="1"

# WHATSAPP_WEBHOOK_URL: Endpoint gateway WhatsApp.
# Mode BRIDGE LOKAL (jalan di PC yang sama, tanpa langganan):
#   1. jalankan `npm run wa:bridge`
#   2. buka http://127.0.0.1:3101/qr lalu pindai sekali memakai WhatsApp
#   3. biarkan URL di bawah ini apa adanya
# Sesi tersimpan di wa-bridge/auth/, sehingga tidak perlu membuka WhatsApp Web manual lagi.
# Kosongkan URL ini bila bridge tidak dijalankan; pesan tetap antre dengan status pending.
WHATSAPP_WEBHOOK_URL="http://127.0.0.1:3101/send"
# WAJIB diisi. Bridge menolak start bila kosong agar endpoint /send tidak terbuka.
# Gunakan nilai acak yang sama untuk WHATSAPP_WEBHOOK_TOKEN dan WA_BRIDGE_TOKEN.
WHATSAPP_WEBHOOK_TOKEN="ganti-token-acak-minimal-16-karakter"

# WA_BRIDGE_*: konfigurasi bridge lokal (dipakai oleh `npm run wa:bridge`).
# Bila WA_BRIDGE_TOKEN kosong, bridge memakai WHATSAPP_WEBHOOK_TOKEN sebagai token bearer.
WA_BRIDGE_HOST="127.0.0.1"
WA_BRIDGE_PORT="3101"
WA_BRIDGE_AUTH_DIR="wa-bridge/auth"
WA_BRIDGE_TOKEN="ganti-token-acak-minimal-16-karakter"

# PAJAK_REKLAME_HARI: Jendela pengingat pajak reklame tahunan dalam hari (default 30).
PAJAK_REKLAME_HARI="30"

# AUTO_CLEAN_TIFF_HARI: Retensi file cetak TIFF dalam hari (default 90).
# Hanya TIFF terverifikasi pada nota selesai yang dihapus; preview/master dipertahankan.
AUTO_CLEAN_TIFF_HARI="90"

# PORT: Port server Express (default 3000).
PORT="3000"
